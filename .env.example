# Sequence - local secrets template.
#
# Copy this to `.env` and fill it in. `.env` is gitignored and must never be
# committed, shared, or pasted into a chat window.
#
#     cp .env.example .env
#
# Use a throwaway testnet key. Nothing here should ever hold mainnet funds.

# Deployer / owner key for Somnia Shannon, 0x-prefixed.
# It pays gas, deploys the factory, and owns the vault it creates for you.
PRIVATE_KEY=

# Total risk limit a newly created vault starts with, raw with 6 decimals.
# 5000000 = $5.00. You can change this later from the app.
MAXOUT=5000000

# Shannon RPC. Only change this if the public endpoint is down.
RPC_URL=https://dream-rpc.somnia.network
